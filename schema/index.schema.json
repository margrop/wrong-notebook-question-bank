{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/margrop/wrong-notebook-question-bank/schema/index.schema.json",
  "title": "wrong-notebook-question-bank-index",
  "description": "共享题库索引，由 scripts/qbank.py build 生成。",
  "type": "object",
  "required": [
    "format",
    "version",
    "updatedAt",
    "packages"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "wrong-notebook-question-bank-index"
    },
    "version": {
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "stage",
          "subject",
          "grades",
          "count",
          "tagged",
          "source",
          "license",
          "updatedAt",
          "collection",
          "file",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "grades": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "tagged": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https?://\\S+$",
            "maxLength": 500
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "file": {
            "type": "string",
            "pattern": "^banks/[a-z0-9-]+/[a-z0-9-]+\\.json$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "enum": [
        "primary",
        "junior_high",
        "senior_high",
        "university"
      ]
    },
    "subject": {
      "enum": [
        "math",
        "english",
        "chinese",
        "science",
        "physics",
        "chemistry",
        "biology",
        "history",
        "geography",
        "politics"
      ]
    },
    "questionType": {
      "enum": [
        "single_choice",
        "multiple_choice",
        "true_false",
        "fill_blank",
        "calculation",
        "solution",
        "reading",
        "cloze",
        "writing",
        "other"
      ]
    }
  }
}
