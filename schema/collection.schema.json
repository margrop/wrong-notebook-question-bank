{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/margrop/wrong-notebook-question-bank/schema/collection.schema.json",
  "title": "wrong-notebook-question-bank-collection",
  "description": "来源集说明：banks/<来源集>/collection.json。",
  "type": "object",
  "required": [
    "id",
    "title",
    "origin",
    "source",
    "license",
    "maintainers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "origin": {
      "enum": [
        "third_party",
        "original"
      ],
      "description": "third_party：整理自他人公开数据；original：贡献者自编或拥有版权"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "license": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-NC-4.0",
        "CC-BY-NC-SA-4.0",
        "MIT",
        "Apache-2.0",
        "BSD-3-Clause",
        "PDDL-1.0",
        "ODbL-1.0"
      ]
    },
    "obtainedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    }
  },
  "if": {
    "properties": {
      "origin": {
        "const": "third_party"
      }
    }
  },
  "then": {
    "required": [
      "sourceUrl"
    ]
  }
}
