{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/margrop/wrong-notebook-question-bank/schema/question-bank.schema.json",
  "title": "wrong-notebook-question-bank",
  "description": "题库包。字段含义与完整规则见 docs/FORMAT.md；内容层面的检查由 scripts/qbank.py validate 完成。",
  "type": "object",
  "required": [
    "format",
    "version",
    "meta",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "wrong-notebook-question-bank"
    },
    "version": {
      "const": 1
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "stage": {
      "enum": [
        "primary",
        "junior_high",
        "senior_high",
        "university"
      ]
    },
    "subject": {
      "enum": [
        "math",
        "english",
        "chinese",
        "science",
        "physics",
        "chemistry",
        "biology",
        "history",
        "geography",
        "politics"
      ]
    },
    "questionType": {
      "enum": [
        "single_choice",
        "multiple_choice",
        "true_false",
        "fill_blank",
        "calculation",
        "solution",
        "reading",
        "cloze",
        "writing",
        "other"
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "stage",
        "subject",
        "grades",
        "count",
        "tagged",
        "source",
        "license",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "grades": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "tagged": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 500
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text",
        "questionType"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "subjectKey": {
          "$ref": "#/$defs/subject"
        },
        "grade": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "semester": {
          "enum": [
            "上",
            "下",
            "全",
            null
          ]
        },
        "questionType": {
          "$ref": "#/$defs/questionType"
        },
        "difficultyStars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "material": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "options": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "maxLength": 10
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "answer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "analysis": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50000
        },
        "knowledgePoints": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "figureSvg": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
